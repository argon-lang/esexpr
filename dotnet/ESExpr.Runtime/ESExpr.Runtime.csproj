<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<LangVersion>15.0</LangVersion>
		<Nullable>Enable</Nullable>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>10</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<Version>0.2.0</Version>
		<NoWarn>CS1998</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<Title>ESExpr Runtime</Title>
		<Description>Runtime library for the ESExpr serialization format</Description>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<RespositoryURL>https://github.com/argon-lang/esexpr</RespositoryURL>
	</PropertyGroup>

	<ItemGroup>
		<None Include="docs/readme.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
