<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>15.0</LangVersion>
		<Nullable>enable</Nullable>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>10</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<Version>0.2.0</Version>
	</PropertyGroup>
	
	<PropertyGroup>
		<Title>ESExpr Source Generator</Title>
		<Description>Source generator for the ESExpr serialization format</Description>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<RespositoryURL>https://github.com/argon-lang/esexpr</RespositoryURL>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<DefineConstants>ESEXPR_SOURCE_GENERATOR</DefineConstants>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0-1.26328.17" PrivateAssets="all" />
		<PackageReference Update="NETStandard.Library" PrivateAssets="all" />
	</ItemGroup>
	
	<ItemGroup>
		<Compile Include="../ESExpr.Runtime/ESExprTag.cs" />
		<Compile Include="../ESExpr.Runtime/ESExprTagSet.cs" />
		<Compile Include="../ESExpr.Runtime/NameUtils.cs" />
		<None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="docs/readme.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
